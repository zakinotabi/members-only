<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tweet Page</title>
  </head>
  <body>
    <main>
      <!-- ============= NAVBAR MODULE ============== -->
     <%- include('navbar', { user: activeUser }) %>

<!-- ===================== BODY MODULE ===================== -->
<main>

  <!-- ---------- Post composer ---------- -->

  <section aria-labelledby="composer-heading">
  <% if (activeUser) { %>

    <h2 id="composer-heading">New post</h2>

    <form action="/posts" method="post">
      <label for="post-content">What's on your mind?</label>
      <textarea id="post-content" name="postContent" rows="4" maxlength="280" required
                placeholder="Write your tweet..."></textarea>
      <p><small>Max 280 characters.</small></p>
      <button type="submit">Post</button>
    </form>
    
    <% } else { %>
      
      <div>make a new post<span>sign-in</span></div>
      
    <% } %>
      
    </section>



  <!-- ---------- Feed ---------- -->
<section aria-labelledby="feed-heading">
  <h2 id="feed-heading">Posts</h2>

  <ul>
    <% allPosts.forEach(post => { %>
      <li>
        <article>
          <header>
            <p>
              <strong><%= allUsers[post.user]?.name %></strong>
              <span>@<%= allUsers[post.user]?.username %></span>
              <!-- &middot;
              <time datetime="<%= //post.datetime %>"><%=// post.formattedDate %></time> -->
            </p>
          </header>

          <p><%= post.content %></p>

          <footer>
            <button type="button">Edit</button>
            <button type="button">Delete</button>
          </footer>
        </article>
      </li>
    <% }) %>
  </ul>
</section>

</main>

<!-- ===================== SIGN IN DIALOG ===================== -->
<dialog id="login-dialog" aria-labelledby="login-title" <%= activeModal === 'login-dialog' ? 'open' : '' %>>
  <form action="/login" method="post">
    <h2 id="login-title">Sign in</h2>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="error-message">
                <%= errorMessage %>
            </div>
        <% } %>


    <p>
      <label for="login-username">Username</label><br>
      <input id="login-username" name="username" type="text"
             autocomplete="username" required>
    </p>

    <p>
      <label for="login-password">Password</label><br>
      <input id="login-password" name="password" type="password"
             autocomplete="current-password" required>
    </p>

    <button type="submit">Sign in</button>
    <button type="button" command="close" commandfor="login-dialog">Cancel</button>
  </form>
</dialog>

<!-- ===================== SIGN UP DIALOG ===================== -->
<dialog id="signup-dialog" aria-labelledby="signup-title">
  <form action="/signup" method="post">
    <h2 id="signup-title">Create an account</h2>


    <p>
      <label for="signup-name">Full name</label><br>
      <input id="signup-name" name="name" type="text"
             autocomplete="name" required>
    </p>

    <p>
      <label for="signup-username">Username</label><br>
      <input id="signup-username" name="username" type="text"
             autocomplete="username" required>
    </p>


    <p>
      <label for="signup-password">Password</label><br>
      <input id="signup-password" name="password" type="password"
             autocomplete="new-password" minlength="8" required>
    </p>

    <p>
      <label for="signup-password-confirm">Confirm password</label><br>
      <input id="signup-password-confirm" name="password_confirm" type="password"
             autocomplete="new-password" minlength="8" required>
    </p>

    <button type="submit">Sign up</button>
    <button type="button" command="close" commandfor="signup-dialog">Cancel</button>
  </form>
</dialog>
  </body>

</html>
