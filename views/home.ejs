<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tweet Page</title>
  </head>
  <body>
    <main>
      <!-- ============= NAVBAR MODULE ============== -->
     <%- include('navbar', { user: activeUser }) %>

<!-- ===================== BODY MODULE ===================== -->
<main>

  <!-- ---------- Post composer ---------- -->

  <section aria-labelledby="composer-heading">
  <% if (activeUser) { %>

    <h2 id="composer-heading">New post</h2>

    <form action="/posts/new" method="post">
      <label for="post-content">What's on your mind?</label>
      <textarea id="post-content" name="postContent" rows="4" maxlength="280" required
                placeholder="Write your tweet..."></textarea>
      <p><small>Max 280 characters.</small></p>
      <button type="submit">Post</button>
    </form>
    
    <% } else { %>
      
      <div>make a new post<span>sign-in</span></div>
      
    <% } %>
      
    </section>


<!-- ---------- Feed ---------- -->
<section aria-labelledby="feed-heading">
  <h2 id="feed-heading">Posts</h2>

  <ul>
    <% allPosts.forEach(post => { %>
      <li>
        <article>
          <header>
            <p>
              <% allUsers.forEach(user => { %>
                <% if (user.id === post.user_id) { %>
                  <img src="https://api.dicebear.com/10.x/marbles/svg?seed=<%= user.username %>" alt="User Avatar" width="20" />
                  <strong><%= user.name %></strong>
                  <span>@<%= user.username %></span>
                <% } %>
              <% }) %>
            </p>
          </header>

          <p><%= post.content %></p>

          <footer>
            <% if (activeUser && activeUser.id == post.user_id) { %>
              <button type="button" popovertarget="edit-<%= post.id %>">Edit</button>
              <button type="button" popovertarget="delete-<%= post.id %>">Delete</button>
            <% } %>
          </footer>
        </article>

        <!-- Edit popover -->
        <div id="edit-<%= post.id %>" popover>
          <form method="post" action="/posts/edit">
            <h2>Edit post</h2>

            <input type="hidden" name="postId" value="<%= post.id %>" />

            <label for="edit-content-<%= post.id %>">Content</label>
            <textarea id="edit-content-<%= post.id %>" name="content" rows="5" required><%= post.content %></textarea>

            <menu>
              <button type="button" popovertarget="edit-<%= post.id %>" popovertargetaction="hide">Cancel</button>
              <button type="submit">Save</button>
            </menu>
          </form>
        </div>

        <!-- Delete confirmation popover -->
        <div id="delete-<%= post.id %>" popover>
          <form method="post" action="/posts/delete">
            <h2>Delete this post?</h2>
            <p>This action can't be undone.</p>

            <input type="hidden" name="postId" value="<%= post.id %>" />

            <menu>
              <button type="button" popovertarget="delete-<%= post.id %>" popovertargetaction="hide">Cancel</button>
              <button type="submit">Delete</button>
            </menu>
          </form>
        </div>

      </li>
    <% }) %>
  </ul>
</section>

<!-- ===================== LOG IN DIALOG ===================== -->
<dialog id="login-dialog" aria-labelledby="login-title" <%= activeModal === 'login-dialog' ? 'open' : '' %>>
  <form action="/user/login" method="post">
    <h2 id="login-title">Login</h2>

        <% if (typeof loginErrorMessage !== 'undefined' && loginErrorMessage) { %>
            <div class="error-message">
                <%= loginErrorMessage %>
            </div>
        <% } %>


    <p>
      <label for="login-username">Username</label><br>
      <input id="login-username" name="username" type="text"
             autocomplete="username" required>
    </p>

    <p>
      <label for="login-password">Password</label><br>
      <input id="login-password" name="password" type="password"
             autocomplete="current-password" required>
    </p>

    <button type="submit">Sign in</button>
    <button type="button" command="close" commandfor="login-dialog">Cancel</button>
  </form>
</dialog>

<!-- ===================== SIGN UP DIALOG ===================== -->
<dialog id="signup-dialog" aria-labelledby="signup-title"  <%= activeModal === 'signup-dialog' ? 'open' : '' %>>
  <form action="/user/signup" method="post">
    <h2 id="signup-title">Create an account</h2>


    <p>
      <label for="signup-name">Full name</label><br>
      <input id="signup-name" name="name" type="text"
             autocomplete="name" required>
    </p>

    <p>
      <label for="signup-username">Username</label><br>
      <input id="signup-username" name="username" type="text"
             autocomplete="username" minlength="3" required>
    
      <% if (signupErrorMessage && signupErrorMessage.username) { %>
        <div class="error-message"><%= signupErrorMessage.username %></div>
      <% } %>
    </p>


    <p>
      <label for="signup-password">Password</label><br>
      <input id="signup-password" name="password" type="password"
             autocomplete="new-password"  required>
      
      <% if (signupErrorMessage && signupErrorMessage.password) { %>
      <div class="error-message"><%= signupErrorMessage.password %></div>
      <% } %>
    </p>

    <p>
      <label for="signup-password-confirm">Confirm password</label><br>
      <input id="signup-password-confirm" name="password_confirm" type="password"
             autocomplete="new-password" minlength="5" required>

      <% if (signupErrorMessage && signupErrorMessage.password_confirm) { %>
      <div class="error-message"><%= signupErrorMessage.password_confirm %></div>
      <% } %>
    </p>

    <button type="submit">Sign up</button>
    <button type="button" command="close" commandfor="signup-dialog">Cancel</button>
  </form>
</dialog>
  </body>

</html>
