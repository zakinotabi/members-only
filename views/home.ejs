<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sticky Notes</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' ry='5' fill='%23ef8354'/></svg>">    
    <link rel="stylesheet" href="/stylesheets/variables.css" />
    <link rel="stylesheet" href="/stylesheets/base.css" />
    <link rel="stylesheet" href="/stylesheets/navbar.css" />
    <link rel="stylesheet" href="/stylesheets/composer.css" />
    <link rel="stylesheet" href="/stylesheets/feed.css" />
    <link rel="stylesheet" href="/stylesheets/modals.css" />
  </head>
  <body class="page">

    <!-- ============= NAVBAR MODULE ============== -->
    <%- include('navbar', { user: activeUser }) %>

    <main id="main-content" class="page-main">

      <!-- ---------- Post composer ---------- -->
      <%- include('partials/postComposer', { activeUser }) %>

      <!-- ---------- Feed ---------- -->
      <section id="feed" class="feed" aria-labelledby="feed-heading">
        <h2 id="feed-heading" class="feed-title">Posts</h2>

        <ul class="feed-grid">
          <% allPosts.forEach(post => { %>
            <li class="feed-item">
              <article class="post">
                <div class="post-author">
                  <% allUsers.forEach(user => { %>
                    <% if (user.id === post.user_id) { %>
                      
                      <img class="post-avatar" src="https://api.dicebear.com/10.x/critters/svg?seed=<%= user.username %>" alt="User Avatar"  />
                      <div class="post-author-info"><strong class="post-name"><%= user.name %></strong>
                      <span class="post-username">@<%= user.username %></span></div>
                    <% } %>
                  <% }) %>
                </div>

                <p class="post-content"><%= post.content %></p>

                <footer class="post-actions">
                  <div class="post-date"><%= post.latest_date %></div>
                  <% if (activeUser && activeUser.id == post.user_id || activeUser && activeUser.username == "admin") { %>
                  <div class="post-actions-buttons-wrap"> 
                    <button type="button" class="btn btn--ghost" popovertarget="edit-post-<%= post.id %>">Edit</button>
                    <button type="button" class="btn btn--danger" popovertarget="delete-post-<%= post.id %>">Delete</button>
                  </div>
                  <% } %>
                </footer>
              </article>

              <!-- ============= edit/delete MODULE ============== -->
              <%- include('partials/editPostForm', { post }) %>
              <%- include('partials/deletePostForm', { post }) %>
            </li>
          <% }) %>
        </ul>
      </section>
    </main>

    <!-- ============= modals MODULE ============== -->
    <%- include('partials/loginModal', { activeModal, loginErrorMessage }) %>
    <%- include('partials/signupModal', { activeModal, signupErrorMessage }) %>
  </body>
</html>
