<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tweet Page</title>
  </head>
  <body>
    <main>

      <!-- ============= NAVBAR MODULE ============== -->
     <%- include('navbar', { user: activeUser }) %>

    <main>

  <!-- ---------- Post composer ---------- -->
  <%- include('partials/postComposer', { activeUser }) %>


<!-- ---------- Feed ---------- -->
<section aria-labelledby="feed-heading">
  <h2 id="feed-heading">Posts</h2>

  <ul>
    <% allPosts.forEach(post => { %>
      <li>
        <article>
          <header>
            <p>
              <% allUsers.forEach(user => { %>
                <% if (user.id === post.user_id) { %>
                  <img src="https://api.dicebear.com/10.x/marbles/svg?seed=<%= user.username %>" alt="User Avatar" width="20" />
                  <strong><%= user.name %></strong>
                  <span>@<%= user.username %></span>
                <% } %>
              <% }) %>
            </p>
          </header>

          <p><%= post.content %></p>

          <footer>
            <% if (activeUser && activeUser.id == post.user_id) { %>
              <button type="button" popovertarget="edit-<%= post.id %>">Edit</button>
              <button type="button" popovertarget="delete-<%= post.id %>">Delete</button>
            <% } %>
          </footer>
        </article>
<!-- ============= edit/delete MODULE ============== -->
        <%- include('partials/editPostForm', { post }) %>
        <%- include('partials/deletePostForm', { post }) %>

      </li>
    <% }) %>
  </ul>
</section>
<!-- ============= modals MODULE ============== -->
<%- include('partials/loginModal', { activeModal, loginErrorMessage }) %>
<%- include('partials/signupModal', { activeModal, signupErrorMessage }) %>
  </body>

</html>
