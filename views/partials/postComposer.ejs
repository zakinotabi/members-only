<section id="composer" class="composer" aria-labelledby="composer-heading">
  <% if (activeUser) { %>
    <h2 id="composer-heading" class="composer-title">New post</h2>

    <form class="composer-form" action="/posts/new" method="post">
      <label class="composer-label" for="post-content">What's on your mind?</label>
      <textarea id="post-content" class="composer-textarea" name="postContent" rows="4" maxlength="280" required
                placeholder="Write your note..."></textarea>
      <p class="composer-hint"><small>Max 280 characters.</small></p>
      <button type="submit" class="btn btn--primary composer-submit">Post</button>
    </form>
  <% } else { %>
    <div class="composer-signin">
      To make a new post
      <button type="button" class="composer-signin-link" command="show-modal" commandfor="login-dialog">sign in</button>
      <span>, or</span> 
      <button type="button" class="composer-signup-link" command="show-modal" commandfor="signup-dialog">join us</button>
    </div>
  <% } %>
</section>
