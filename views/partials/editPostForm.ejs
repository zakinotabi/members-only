<div id="edit-post-<%= post.id %>" class="popover-card popover-card--edit" popover>
  <form class="popover-card-form" method="post" action="/posts/edit">
    <h2 class="popover-card-title">Edit post</h2>

    <input type="hidden" name="postId" value="<%= post.id %>" />

    <div class="form-field">
      <label for="edit-content-<%= post.id %>">Content</label>
      <textarea id="edit-content-<%= post.id %>" name="content" rows="5" required><%= post.content %></textarea>
    </div>

    <menu class="popover-card-actions">
      <button type="button" class="btn btn--ghost" popovertarget="edit-post-<%= post.id %>" popovertargetaction="hide">Cancel</button>
      <button type="submit" class="btn btn--primary">Save</button>
    </menu>
  </form>
</div>
